{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stickyhomeworks2 · N",
  "version": "0.1.0",
  "identifier": "com.classisband.stickyhomeworks2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "stickyhomeworks2N",
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "visible": false
      },
      {
        "label": "tray-menu",
        "create": false,
        "title": "stickyhomeworks2N",
        "url": "index.html#/tray-menu",
        "width": 320,
        "height": 260,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 ws://127.0.0.1:1420 https://api.classisband.xyz; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
